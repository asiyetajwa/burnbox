# Copy to .env on the host. Never commit .env.
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=
STUB_LLM=0
SANDBOX_RUNTIME=
PUBLIC_PORT=80
RUNS_PER_HOUR=30
MAX_CONCURRENT_RUNS=2
# Forward It To Burn Box: set a domain whose MX record points at this VM; mail to check@MAIL_DOMAIN becomes an email run.
MAIL_DOMAIN=
